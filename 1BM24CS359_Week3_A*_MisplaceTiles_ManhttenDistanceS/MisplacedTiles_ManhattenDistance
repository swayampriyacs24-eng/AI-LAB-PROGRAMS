import heapq

# Initial and goal state
start = (1, 2, 3,
         4, 0, 6,
         7, 5, 8)

goal = (1, 2, 3,
        4, 5, 6,
        7, 8, 0)


# Misplaced Tiles
def misplaced(state):
    return sum(state[i] != goal[i] and state[i] != 0
               for i in range(9))


# Manhattan Distance
def manhattan(state):
    distance = 0

    for i in range(9):
        if state[i] != 0:
            x = state[i]

            current_row = i // 3
            current_col = i % 3

            goal_pos = goal.index(x)
            goal_row = goal_pos // 3
            goal_col = goal_pos % 3

            distance += abs(current_row - goal_row)
            distance += abs(current_col - goal_col)

    return distance


# Generate next states
def moves(state):
    result = []

    zero = state.index(0)
    row = zero // 3
    col = zero % 3

    positions = []

    if row > 0:
        positions.append(zero - 3)
    if row < 2:
        positions.append(zero + 3)
    if col > 0:
        positions.append(zero - 1)
    if col < 2:
        positions.append(zero + 1)

    for pos in positions:
        new_state = list(state)

        new_state[zero], new_state[pos] = \
            new_state[pos], new_state[zero]

        result.append(tuple(new_state))

    return result


# Print puzzle
def display(state):
    print(state[0], state[1], state[2])
    print(state[3], state[4], state[5])
    print(state[6], state[7], state[8])
    print()


# A* Search
def astar(start, heuristic):

    queue = [(heuristic(start), 0, start, [])]
    visited = set()

    while queue:

        f, g, current, path = heapq.heappop(queue)

        if current in visited:
            continue

        visited.add(current)

        if current == goal:
            return path + [current]

        for next_state in moves(current):

            if next_state not in visited:
                new_g = g + 1
                new_f = new_g + heuristic(next_state)

                heapq.heappush(
                    queue,
                    (new_f, new_g, next_state, path + [current])
                )


# ---------------- MAIN ----------------

print("Initial State:")
display(start)

print("Choose Heuristic:")
print("1. Misplaced Tiles")
print("2. Manhattan Distance")

choice = int(input("Enter choice: "))

if choice == 1:
    heuristic = misplaced
    print("\nUsing Misplaced Tiles")

elif choice == 2:
    heuristic = manhattan
    print("\nUsing Manhattan Distance")

else:
    print("Invalid choice")
    exit()


solution = astar(start, heuristic)

print("\nSolution:")

for i, state in enumerate(solution):
    print("Step", i)
    display(state)

print("Total moves:", len(solution) - 1)
