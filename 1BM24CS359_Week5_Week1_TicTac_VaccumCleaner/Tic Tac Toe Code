WIN_LINES = [
    (1, 2, 3), (4, 5, 6), (7, 8, 9),   # rows
    (1, 4, 7), (2, 5, 8), (3, 6, 9),   # columns
    (1, 5, 9), (3, 5, 7),              # diagonals
]


def new_board():
    return {i: " " for i in range(1, 10)}


def show_board(board):
    print()
    print(f" {board[1]} | {board[2]} | {board[3]}")
    print("---+---+---")
    print(f" {board[4]} | {board[5]} | {board[6]}")
    print("---+---+---")
    print(f" {board[7]} | {board[8]} | {board[9]}")
    print()


def has_won(board, mark):
    for a, b, c in WIN_LINES:
        if board[a] == board[b] == board[c] == mark:
            return True
    return False


def is_full(board):
    return all(cell != " " for cell in board.values())


def ask_move(board, mark):
    while True:
        choice = input(f"Player {mark}, choose a square (1-9): ").strip()
        if not choice.isdigit() or not (1 <= int(choice) <= 9):
            print("Please enter a number from 1 to 9.")
        elif board[int(choice)] != " ":
            print("That square is already taken.")
        else:
            return int(choice)


def play():
    print("=== TIC-TAC-TOE (2 Players) ===")
    print("Squares are numbered like this:")
    show_board({i: str(i) for i in range(1, 10)})

    board = new_board()
    current = "X"

    while True:
        show_board(board)
        move = ask_move(board, current)
        board[move] = current

        if has_won(board, current):
            show_board(board)
            print(f"Player {current} wins!")
            break
        if is_full(board):
            show_board(board)
            print("It's a draw!")
            break

        current = "O" if current == "X" else "X"





if __name__ == "__main__":
    while True:
        play()
        again = input("Play again? (y/n): ").strip().lower()
        if again != "y":
            break
