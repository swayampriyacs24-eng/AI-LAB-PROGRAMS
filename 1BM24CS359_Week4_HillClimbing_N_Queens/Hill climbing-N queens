
def cost(board):
    conflicts = 0
    n = len(board)

    for i in range(n):
        for j in range(i + 1, n):
            # Same row or same diagonal
            if board[i] == board[j] or abs(board[i] - board[j]) == abs(i - j):
                conflicts += 1

    return conflicts


def print_board(board):
    n = len(board)
    for row in range(n):
        for col in range(n):
            if board[col] == row:
                print("Q", end=" ")
            else:
                print(".", end=" ")
        print()


def hill_climbing():
    n = 4
    board = [3, 1, 2, 0]  # Initial state

    while True:
        current_cost = cost(board)

        print("\nCurrent state:", board)
        print("Current cost:", current_cost)
        print_board(board)

        if current_cost == 0:
            print("Goal reached!")
            break

        best_board = board[:]
        best_cost = current_cost


        for col in range(n):
            for row in range(n):
                if row != board[col]:
                    neighbor = board[:]
                    neighbor[col] = row
                    neighbor_cost = cost(neighbor)



                    if neighbor_cost < best_cost:
                        best_cost = neighbor_cost
                        best_board = neighbor

        # Stop if no better neighbor exists
        if best_cost >= current_cost:

            board = [0, 0, 0, 0]
            continue

        print("\nSelected neighbor:", best_board)
        print("Selected cost:", best_cost)

        board = best_board


hill_climbing()
